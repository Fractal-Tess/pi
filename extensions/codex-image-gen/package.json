{
  "name": "codex-image-gen",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit -p .",
    "format": "prettier --write \"index.ts\" \"src/**/*.ts\" \"*.json\"",
    "format:check": "prettier --check \"index.ts\" \"src/**/*.ts\" \"*.json\"",
    "test": "node --test --experimental-strip-types src/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
